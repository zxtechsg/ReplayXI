<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Replay XI</string>
	<key>NSHandsTrackingUsageDescription</key>
	<string>Replay XI uses hand pinches to move and resize the replay pitch. Hand data stays on this device.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to Replay XI Coach on your local network for live playback and annotation control.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_replayxi-coach._tcp</string>
	</array>
	<key>NSWorldSensingUsageDescription</key>
	<string>Replay XI detects floors and tables so you can place the replay pitch on a real surface. Room data stays on this device.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationPreferredDefaultSceneSessionRole</key>
		<string>UIWindowSceneSessionRoleApplication</string>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
</dict>
</plist>
